+def _check_offset_tensor_g1(surface: object) -> None:
+    """Certify non-rational C0 joins by their entire derivative control net.
+
+    At multiplicity = degree the seam interpolates one control row. If every
+    transverse derivative control vector on the right is the same positive
+    multiple of its left counterpart, the derivative curves are proportional
+    for every point of the seam, not just at sampled parameters.
+    """
+    if surface.IsURational() or surface.IsVRational():
+        raise ValueError("rational C0 offset tensor requires a verified G1 join")
+    if surface.IsUPeriodic() or surface.IsVPeriodic():
+        raise ValueError("periodic C0 offset tensor requires a verified seam")
+    for along_u in (True, False):
+        degree = surface.UDegree() if along_u else surface.VDegree()
+        count = surface.NbUKnots() if along_u else surface.NbVKnots()
+        multiplicity = surface.UMultiplicity if along_u else surface.VMultiplicity
+        across = surface.NbVPoles() if along_u else surface.NbUPoles()
+        cumulative = multiplicity(1)
+        for index in range(2, count):
+            mult = multiplicity(index)
+            cumulative += mult
+            if mult < degree:
+                continue
+            if mult > degree:
+                raise ValueError("offset tensor has a discontinuous internal seam")
+            seam = cumulative - degree
+            ratio = None
+            for row in range(1, across + 1):
+                def pole(column):
+                    return surface.Pole(column, row) if along_u else surface.Pole(row, column)
+                left = tuple(b-a for a,b in zip(pole(seam-1).Coord(),pole(seam).Coord(),strict=True))
+                right = tuple(b-a for a,b in zip(pole(seam).Coord(),pole(seam+1).Coord(),strict=True))
+                length = _magnitude(left)
+                other = _magnitude(right)
+                if max(length, other) <= 1e-14:
+                    continue
+                if min(length, other) <= 1e-14:
+                    raise ValueError("offset tensor has a singular G1 control vector")
+                current = sum(a*b for a,b in zip(left,right,strict=True)) / length**2
+                if current <= 0:
+                    raise ValueError("offset tensor has a non-G1 join")
+                if ratio is None:
+                    ratio = current
+                residual = _magnitude(tuple(b-ratio*a for a,b in zip(left,right,strict=True)))
+                if residual > 1e-9*max(other, ratio*length):
+                    raise ValueError("offset tensor has a non-G1 derivative control net")
+            if ratio is None:
+                raise ValueError("offset tensor has a degenerate seam")
