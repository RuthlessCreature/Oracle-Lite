+def _check_offset_profile_g1(surface: object) -> None:
+    """Check every internal profile knot, without changing the source spline.
+
+    Extrusion/revolution profiles and non-rational tensor surfaces with
+    proportional derivative control nets are supported. Other C0 surfaces
+    and actual creases remain rejected.
+    """
+    from OCP.Geom import (
+        Geom_BSplineCurve,
+        Geom_BSplineSurface,
+        Geom_SurfaceOfLinearExtrusion,
+        Geom_SurfaceOfRevolution,
+    )
