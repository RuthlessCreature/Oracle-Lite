+def project_surface(point: object, surface: object, tolerance: float) -> tuple:
+    """Stable closest point/normal for elementary supports and kernel projection otherwise.
+
+    An almost-flat cone has a distant apex and badly conditioned kernel UV
+    projection. Work in its radial/axial meridian without subtracting the apex.
+    Both nappes are considered; no source angle or geometry is replaced.
+    """
+    from math import sin, cos, sqrt
+    from OCP.Geom import Geom_ConicalSurface, Geom_CylindricalSurface
+    from OCP.GeomAPI import GeomAPI_ProjectPointOnSurf
+    from OCP.gp import gp_Pnt, gp_Vec
+
+    if isinstance(surface, (Geom_ConicalSurface, Geom_CylindricalSurface)):
+        frame = surface.Position()
+        axis = frame.Direction().Coord()
+        origin = frame.Location().Coord()
+        offset = tuple(x - y for x, y in zip(point.Coord(), origin, strict=True))
+        axial = _dot(offset, axis)
+        radial = tuple(offset[i] - axial * axis[i] for i in range(3))
+        rho = sqrt(_dot(radial, radial))
+        if rho > 1e-14:
+            direction = tuple(x / rho for x in radial)
+            if isinstance(surface, Geom_CylindricalSurface):
+                q = gp_Pnt(
+                    *(
+                        origin[i] + axial * axis[i] + surface.Radius() * direction[i]
+                        for i in range(3)
+                    )
+                )
+                return q, direction, abs(rho - surface.Radius())
+            sine, cosine = sin(surface.SemiAngle()), cos(surface.SemiAngle())
+            candidates = []
+            for sign in (1.0, -1.0):
+                meridian = (sign * rho - surface.RefRadius()) * sine + axial * cosine
+                radius = surface.RefRadius() + meridian * sine
+                q = gp_Pnt(
+                    *(
+                        origin[i] + meridian * cosine * axis[i] + sign * radius * direction[i]
+                        for i in range(3)
+                    )
+                )
+                normal = tuple(sign * cosine * direction[i] - sine * axis[i] for i in range(3))
+                candidates.append((q, normal, point.Distance(q)))
+            return min(candidates, key=lambda result: result[2])
