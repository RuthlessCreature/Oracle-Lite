+        raise ValueError("C0 offset basis requires a B-spline profile")
+    for index in range(2, curve.NbKnots()):
+        if curve.Multiplicity(index) < curve.Degree():
+            continue
+        left, right = gp_Pnt(), gp_Pnt()
+        dl, dr = gp_Vec(), gp_Vec()
+        parameter = curve.Knot(index)
+        curve.LocalD1(parameter, index - 1, index, left, dl)
+        curve.LocalD1(parameter, index, index + 1, right, dr)
+        if (
+            left.Distance(right) > 1e-12
+            or min(dl.Magnitude(), dr.Magnitude()) <= 1e-14
+            or dl.Angle(dr) > 1e-9
+        ):
